@model final.ViewModels.PlaceOrderInputModel
@using final.Models
@using System.Globalization

@{
    ViewData["Title"] = "Thông tin đặt hàng";
    var products = ViewData["Products"] as IReadOnlyList<Product> ?? Array.Empty<Product>();
}

<section class="checkout-page">
    <a class="checkout-back" asp-controller="Home" asp-action="Index">← Quay lại cửa hàng</a>
    <header class="checkout-heading">
        <span class="section-eyebrow">SẮP HOÀN TẤT</span>
        <h1>Thông tin đặt hàng</h1>
        <p>Điền thông tin nhận hàng để chúng tôi gửi đơn đến bạn.</p>
    </header>

    <div class="checkout-layout">
        <section class="checkout-card">
            <h2>Thông tin người nhận</h2>
            <p class="checkout-subtitle">Các trường có dấu * là bắt buộc.</p>
            <form asp-controller="Orders" asp-action="Checkout" method="post" id="checkout-order-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="checkout-field">
                    <label asp-for="CustomerName"></label>
                    <input asp-for="CustomerName" class="form-control" autocomplete="name" placeholder="Nguyễn Văn An" />
                    <span asp-validation-for="CustomerName" class="field-error"></span>
                </div>

                <div class="checkout-field">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" class="form-control" type="tel" autocomplete="tel" placeholder="09xx xxx xxx" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>

                <div class="checkout-field">
                    <label asp-for="DeliveryAddress"></label>
                    <textarea asp-for="DeliveryAddress" class="form-control" autocomplete="street-address" rows="2"
                              placeholder="Số nhà, đường, phường/xã, tỉnh/thành"></textarea>
                    <span asp-validation-for="DeliveryAddress" class="field-error"></span>
                </div>

                <div class="checkout-field">
                    <label asp-for="Note"></label>
                    <textarea asp-for="Note" class="form-control" rows="2" placeholder="Ví dụ: giao vào giờ hành chính"></textarea>
                    <span asp-validation-for="Note" class="field-error"></span>
                </div>

                <div id="checkout-hidden-items"></div>
                <button type="submit" class="btn order-submit" id="place-order-button">Xác nhận đặt hàng</button>
            </form>
            <p class="admin-change-note">Sau khi đặt, bạn không thể tự sửa đơn. Nếu cần thay đổi, vui lòng liên hệ Admin.</p>
        </section>

        <aside class="checkout-card order-summary">
            <h2>Đơn hàng của bạn</h2>
            <div id="checkout-items" class="checkout-items" aria-live="polite"></div>
            <div class="checkout-grand-total"><span>Tổng thanh toán</span><strong id="checkout-total">0 ₫</strong></div>
            <div class="checkout-products" hidden>
                @foreach (var product in products)
                {
                    <span data-product-id="@product.Id" data-product-name="@product.Name"
                          data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)"></span>
                }
            </div>
        </aside>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
