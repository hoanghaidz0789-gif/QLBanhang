@using System.Globalization
@model IReadOnlyList<final.Models.Product>

@if (Model.Count == 0)
{
    <div class="catalog-empty">Chưa có sản phẩm trong danh mục này.</div>
}
else
{
    @foreach (var product in Model)
    {
        <article class="product-card">
            <div class="product-art">
                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" alt="@product.Name" />
                }
                else
                {
                    <span aria-hidden="true">@(product.Category == "Laptop" ? "💻" : product.Category == "Phụ kiện" ? "🎧" : "📱")</span>
                }
            </div>
            <div class="product-category">@product.Category</div>
            <h3>@product.Name</h3>
            <p class="product-description">@product.Description</p>
            <div class="product-bottom">
                <strong>@product.Price.ToString("N0") ₫</strong>
                <button class="btn btn-primary add-to-cart" type="button"
                        data-product-id="@product.Id" data-product-name="@product.Name"
                        data-product-price="@product.Price.ToString(CultureInfo.InvariantCulture)">
                    Thêm vào giỏ
                </button>
            </div>
        </article>
    }
}
