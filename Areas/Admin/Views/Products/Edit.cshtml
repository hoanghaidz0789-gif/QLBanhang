@model final.ViewModels.AdminProductInputModel
@{
    ViewData["Title"] = "Sửa sản phẩm";
    var imageUrl = ViewData["CurrentImageUrl"] as string;
}

<section class="admin-page admin-edit-page">
    <a class="admin-back-link" asp-area="Admin" asp-controller="Products" asp-action="Index">← Quay lại danh sách sản phẩm</a>
    <div class="admin-page-heading">
        <div><span class="section-eyebrow">N1736 SHOP · QUẢN TRỊ</span><h1>Sửa sản phẩm</h1><p>Để trống ảnh mới nếu muốn giữ ảnh hiện tại.</p></div>
    </div>
    <div class="admin-edit-layout">
        <section class="admin-orders-card admin-form-card">
            <form asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary"></div>
                <div class="checkout-field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-error"></span></div>
                <div class="checkout-field"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
                <div class="checkout-field"><label asp-for="Category"></label><input asp-for="Category" class="form-control" /><span asp-validation-for="Category" class="field-error"></span></div>
                <div class="checkout-field"><label asp-for="Price"></label><input asp-for="Price" class="form-control" type="number" min="0.01" step="0.01" /><span asp-validation-for="Price" class="field-error"></span></div>
                <div class="checkout-field">
                    <label asp-for="ImageFile"></label>
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img class="admin-product-image admin-product-image-preview" src="@imageUrl" alt="Ảnh hiện tại của @Model.Name" />
                    }
                    <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <small class="admin-notice">JPG, PNG hoặc WebP; tối đa 5 MB.</small>
                    <span asp-validation-for="ImageFile" class="field-error"></span>
                </div>
                <div class="admin-edit-actions">
                    <button type="submit" class="btn admin-save-button">Lưu thay đổi</button>
                    <a class="btn admin-cancel-button" asp-area="Admin" asp-controller="Products" asp-action="Index">Hủy</a>
                </div>
            </form>
        </section>
        @if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            <aside class="admin-orders-card admin-order-preview"><h2>Ảnh đang sử dụng</h2><img class="admin-product-image admin-product-image-large" src="@imageUrl" alt="@Model.Name" /></aside>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
